@echo off
rem Starts myLibrary (no console window stays open). The first start also creates
rem "myLibrary" shortcuts on the Desktop and in the Start menu; use those from then on.
if exist "%~dp0runtime\python\pythonw.exe" (
  start "" "%~dp0runtime\python\pythonw.exe" "%~dp0launch.py"
  exit /b 0
)
rem Not next to the rest of the package (copied out on its own, or opened inside the zip):
rem explain in a message box, in Chinese and English (the text is encoded for PowerShell)
powershell -NoProfile -EncodedCommand 
exit /b 1
