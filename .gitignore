# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# The books are copyrighted: they stay on this computer only, never in git, wherever they are.
# (.gitkeep keeps the library's empty books/ folder in a fresh clone.)
# Both spellings: macOS and Linux tell .pdf and .PDF apart, so one rule alone would miss some
*.pdf
*.PDF
library/books/*
!library/books/.gitkeep
library/papers/*
!library/papers/.gitkeep
library/theses/*
!library/theses/.gitkeep

# Which library the tool opens on this computer (see scripts/paths.py)
local.toml

# Local-only folders, in the tool and in any library:
#   .cache/   rebuildable data (PDF viewer, dictionary, search index, chapter pages, OCR)
#   archive/  removed books, original scans, pre-bookmark copies
.cache/
archive/
#   .myLibrary/  the tool's own records: migration backups and journals, operations in progress
.myLibrary/

# The previous version of the reading log and review progress, kept on this computer in case
# the file is ever damaged (scripts/safe_io.py)
*.bak

# Generated from catalog.csv + notes; contains local file paths
library.html

# Copies of edited files kept by VS Code's "Local History" extension
.history/

# OS / editor
.DS_Store
Thumbs.db

# The ready-to-use package, built by scripts/build_package.py
dist/
